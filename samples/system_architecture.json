{
  "system": "OmniDoc Studio",
  "version": "2.0.0",
  "architecture": {
    "runtime": "Electron 33",
    "frontend": "React 18 + TypeScript + Vite",
    "stateManagement": "Zustand 5",
    "encryption": "electron.safeStorage (OS Keychain)"
  },
  "adapters": [
    {
      "format": "markdown",
      "parser": "marked",
      "extensions": ["katex", "highlight.js"]
    },
    {
      "format": "pdf",
      "renderer": "pdfjs-dist"
    },
    {
      "format": "docx",
      "pipeline": ["mammoth", "tiptap-v2", "docx-packer"]
    },
    {
      "format": "data",
      "types": ["csv", "json"],
      "capabilities": ["interactive-grid", "sort", "filter", "inline-edit"]
    }
  ],
  "aiEngine": {
    "providers": ["gemini", "openai", "anthropic", "openrouter", "ollama"],
    "searchEngines": ["tavily", "exa"]
  }
}
