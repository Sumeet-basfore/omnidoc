{
  "name": "omnidoc-studio",
  "version": "2.0.0",
  "description": "DocsViewer (OmniDoc Studio) - Unified Multi-Format Desktop Studio & AI Research Assistant",
  "main": "./out/main/index.js",
  "author": "OmniDoc Studio Team",
  "homepage": "https://github.com/omnidoc/omnidoc-studio",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@google/generative-ai": "^0.21.0",
    "@tavily/core": "^0.5.0",
    "@tiptap/extension-highlight": "^2.9.0",
    "@tiptap/extension-link": "^2.9.0",
    "@tiptap/extension-table": "^2.9.0",
    "@tiptap/extension-table-cell": "^2.9.0",
    "@tiptap/extension-table-header": "^2.9.0",
    "@tiptap/extension-table-row": "^2.9.0",
    "@tiptap/extension-text-align": "^2.9.0",
    "@tiptap/react": "^2.9.0",
    "@tiptap/starter-kit": "^2.9.0",
    "clsx": "^2.1.1",
    "docx": "^9.1.0",
    "electron-updater": "^6.3.9",
    "exa-js": "^1.4.0",
    "highlight.js": "^11.10.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.8.0",
    "marked": "^14.1.2",
    "openai": "^4.67.0",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^1.22.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
